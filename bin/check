#!/usr/bin/env bash
set -euo pipefail

validate_args=()
if [[ ${1-} == --allow-missing ]]; then
  validate_args+=(--allow-missing)
  shift
fi
if (( $# > 0 )); then
  echo "Usage: bin/check [--allow-missing]" >&2
  exit 1
fi

repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

for file in runner/*.cjs lib/*.cjs fixtures/*.cjs scenarios/*.cjs tools/*.cjs; do
  node --check "$file"
done
node tools/check-terminal.cjs
node tools/check-console.cjs
node tools/check-crop.cjs
node tools/check-font.cjs
node tools/check-topology.cjs
node tools/check-provenance.cjs
node tools/check-dataset-links.cjs
node tools/check-i18n.cjs
mapfile -d '' shell_fixtures < <(find tests/fixtures -type f -name '*.sh' -print0 | sort -z)
bash -n bin/capture bin/contact-sheet bin/devcluster test-runner.sh "${shell_fixtures[@]}"
shellcheck bin/capture bin/contact-sheet bin/devcluster test-runner.sh "${shell_fixtures[@]}"
jq empty captures.json cluster/default-config.json fixtures/production-shape.json
nix-instantiate --parse cluster/nix/test.nix >/dev/null
while IFS= read -r -d '' nix_test; do
  nix-instantiate --parse "$nix_test" >/dev/null
done < <(find tests -type f -name '*.nix' -print0 | sort -z)
tests_meta=$(mktemp)
trap 'rm -f "$tests_meta"' EXIT
nix eval .#testsMeta.x86_64-linux --json >"$tests_meta"
ruby -c bin/validate
ruby -c cluster/seed-production-shape.rb
ruby -c tools/check-contract.rb
ruby -c tools/check-kb-annotations.rb
ruby -c tools/article-runtime-matrix.rb
ruby -c tools/check-article-contract.rb
ruby -c tools/check-managed-article-sources.rb
ruby -c tests/runner/extensions/vpsadmin_services.rb
ruby tools/check-seed.rb
ruby tools/check-contract.rb
ruby tools/check-kb-annotations.rb
ruby tools/check-article-contract.rb --tests-meta "$tests_meta"
ruby tools/check-managed-article-sources.rb
ruby tools/test-contract.rb
ruby tools/test-kb-annotations.rb
ARTICLE_TESTS_META="$tests_meta" ruby tools/test-article-contract.rb
ruby tools/test-managed-article-sources.rb
ruby tools/article-runtime-matrix.rb | jq -e '
  .include | length > 0 and all(.[]; .article | type == "string")
' >/dev/null
node tools/test-browser.cjs
bin/validate "${validate_args[@]}"
