#!/usr/bin/env bash
set -euo pipefail

validate_args=()
if [[ ${1-} == --allow-missing ]]; then
  validate_args+=(--allow-missing)
  shift
fi
if (( $# > 0 )); then
  echo "Usage: bin/check [--allow-missing]" >&2
  exit 1
fi

repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

for file in runner/*.cjs lib/*.cjs fixtures/*.cjs scenarios/*.cjs tools/*.cjs; do
  node --check "$file"
done
node tools/check-terminal.cjs
node tools/check-console.cjs
node tools/check-crop.cjs
node tools/check-font.cjs
node tools/check-topology.cjs
node tools/check-provenance.cjs
node tools/check-dataset-links.cjs
node tools/check-i18n.cjs
bash -n bin/capture bin/contact-sheet bin/devcluster test-runner.sh tests/fixtures/kvm/*.sh
shellcheck bin/capture bin/contact-sheet bin/devcluster test-runner.sh tests/fixtures/kvm/*.sh
jq empty captures.json cluster/default-config.json fixtures/production-shape.json
nix-instantiate --parse cluster/nix/test.nix >/dev/null
nix-instantiate --parse tests/all-tests.nix >/dev/null
nix-instantiate --parse tests/make-test.nix >/dev/null
nix-instantiate --parse tests/suite/kb/kvm-guest.nix >/dev/null
nix-instantiate --parse tests/suite/kb/kvm.nix >/dev/null
nix eval .#testsMeta.x86_64-linux --json | jq -e '
  .["kb/kvm"].testScripts
  | keys == ["libvirt", "networking", "nfs-locking", "platform-defaults", "storage"]
    and all(.[]; .tags | index("kb-runtime"))
' >/dev/null
ruby -c bin/validate
ruby -c cluster/seed-production-shape.rb
ruby -c tools/check-contract.rb
ruby -c tools/check-kb-annotations.rb
ruby -c tools/check-runtime-contract.rb
ruby -c tests/runner/extensions/vpsadmin_services.rb
ruby tools/check-seed.rb
ruby tools/check-contract.rb
ruby tools/check-kb-annotations.rb
ruby tools/check-runtime-contract.rb
ruby tools/test-contract.rb
ruby tools/test-kb-annotations.rb
ruby tools/test-runtime-contract.rb
node tools/test-browser.cjs
bin/validate "${validate_args[@]}"
